# Backend environment variables for Render deployment
# REQUIRED: All variables must be set or the backend will fail on startup

MONGO_URI=mongodb+srv://<dbuser>:<password>@cluster0.mongodb.net/delivo?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_here
FRONTEND_URL=https://your-frontend.vercel.app

# Email Configuration (Standalone nodemailer service)
# Point this at the independent email service for verification and reset emails.
EMAIL_SERVICE_URL=http://localhost:5001/api/email

# SMTP values used by the standalone service itself
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@example.com
MAIL_PASS=your-password-or-api-key
MAIL_FROM=Your App <noreply@example.com>

# Firebase Admin SDK service account configuration
# Preferred: keep the full JSON in Render's secret env var to avoid committing credentials.
# Set FIREBASE_SERVICE_ACCOUNT_JSON to the raw JSON string of the Firebase service account.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional fallback only if you intentionally want to use a file path instead of a secret env var.
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Optional (defaults are reasonable)
# NODE_ENV=production
# PORT=10000

# ================= M-PESA DARAJA CONFIGURATION =================
# MPESA_ENV=sandbox # sandbox or production
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke # or https://api.safaricom.co.ke
MPESA_KEY=your_daraja_consumer_key
MPESA_SECRET=your_daraja_consumer_secret
MPESA_BUSINESS_SHORTCODE=your_c2b_paybill_shortcode
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
MPESA_CALLBACK_URL=https://api.yourdomain.com/api/mpesa/callback
MPESA_CALLBACK_SECRET=your_secure_random_callback_secret_token

# ================= M-PESA B2C (RIDER PAYOUTS) CONFIGURATION =================
# Optional: Provide dedicated B2C credentials if separate from C2B key/secret
# MPESA_B2C_KEY=your_b2c_consumer_key
# MPESA_B2C_SECRET=your_b2c_consumer_secret
MPESA_B2C_SHORTCODE=your_b2c_working_shortcode
MPESA_B2C_INITIATOR_NAME=your_initiator_username
# Either provide the pre-encrypted base64 SecurityCredential OR initiator password + cert:
MPESA_B2C_SECURITY_CREDENTIAL=your_pre_encrypted_base64_security_credential
# MPESA_B2C_INITIATOR_PASSWORD=your_initiator_password
# MPESA_B2C_CERT_PATH=./config/safaricom_public_cert.cer
MPESA_B2C_COMMAND_ID=BusinessPayment # BusinessPayment or SalaryPayment
MPESA_B2C_RESULT_URL=https://api.yourdomain.com/api/payouts/b2c/result
MPESA_B2C_TIMEOUT_URL=https://api.yourdomain.com/api/payouts/b2c/timeout

